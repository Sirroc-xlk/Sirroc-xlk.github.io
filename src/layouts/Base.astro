---
import { SITE } from '../site.config';
interface Props { title?: string; description?: string; frontmatter?: { title?: string } }
const { description = SITE.description } = Astro.props;
const title = Astro.props.title ?? Astro.props.frontmatter?.title;
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header class="wrap site-header">
      <a href="/" class="brand">{SITE.title}</a>
      <nav>
        <a href="/" class:list={{ active: path === '/' }}>文章</a>
        <a href="/tags/" class:list={{ active: path.startsWith('/tags') }}>标签</a>
        <a href="/about/" class:list={{ active: path.startsWith('/about') }}>关于</a>
      </nav>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="wrap site-footer">
      © {new Date().getFullYear()} {SITE.author}
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbfaf7;
    --text: #2b2b2b;
    --muted: #7a7670;
    --line: #e7e3dc;
    --accent: #2f6f5e;
    --code-bg: #f1eee8;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #1b1c1e;
      --text: #e4e2de;
      --muted: #9a968f;
      --line: #33343a;
      --accent: #7cc3ad;
      --code-bg: #26272b;
    }
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB",
      "Microsoft YaHei", "Noto Sans SC", sans-serif;
    font-size: 17px;
    line-height: 1.8;
  }
  .wrap { max-width: 720px; margin: 0 auto; padding: 0 20px; }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  .site-header {
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 8px;
    padding-top: 36px; padding-bottom: 28px;
  }
  .brand { font-size: 1.3rem; font-weight: 700; color: var(--text); }
  nav { display: flex; gap: 20px; }
  nav a { color: var(--muted); }
  nav a.active { color: var(--text); font-weight: 600; }
  .site-footer {
    margin-top: 64px; padding-top: 20px; padding-bottom: 40px;
    border-top: 1px solid var(--line); color: var(--muted); font-size: 0.9rem;
  }
  h1, h2, h3 { line-height: 1.4; }
  img { max-width: 100%; height: auto; border-radius: 6px; }
  pre { padding: 14px 16px; border-radius: 8px; overflow-x: auto; font-size: 0.9rem; }
  code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  :not(pre) > code { background: var(--code-bg); padding: 2px 6px; border-radius: 4px; font-size: 0.9em; }
  blockquote { margin: 1.2em 0; padding: 0.2em 1em; border-left: 3px solid var(--accent); color: var(--muted); }
  hr { border: 0; border-top: 1px solid var(--line); margin: 2em 0; }
  table { border-collapse: collapse; width: 100%; display: block; overflow-x: auto; }
  th, td { border: 1px solid var(--line); padding: 6px 10px; }
  .muted { color: var(--muted); }
  .tag {
    display: inline-block; font-size: 0.8rem; padding: 0 8px; margin-right: 6px;
    border: 1px solid var(--line); border-radius: 999px; color: var(--muted);
  }
</style>
